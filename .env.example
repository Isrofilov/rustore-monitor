# Ключ доступа к RuStore API
RUSTORE_KEY_ID=2351027525
RUSTORE_PRIVATE_KEY=base64-закодированный-приватный-ключ

# Приложение
RUSTORE_PACKAGE_NAME=com.example.app
RUSTORE_APP_ID=123456

# …или несколько приложений: пакет:appId[:название] через запятую (вместо двух строк выше)
# RUSTORE_APPS=com.example.app:123456:Моё приложение,com.example.game:654321:Игра

# Каналы уведомлений — настройте хотя бы один (Telegram и/или Matrix)

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=123        # id темы в супергруппе (опционально)
# TELEGRAM_DOMAIN=api.telegram.org  # домен Telegram API (опционально)

# Matrix
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=syt_xxx...
# MATRIX_ROOM_ID=!abcdef:matrix.org

# Интервал опроса в секундах (по умолчанию 300)
# POLL_INTERVAL=300

# Часовой пояс — смещение в часах (по умолчанию +3, МСК)
# TZ_OFFSET=3

# Платежи и возвраты проверяются за последние N дней (по умолчанию 7)
# PAYMENTS_LOOKBACK_DAYS=7

# Дополнительные проверки (1 — вкл., 0 — выкл.; по умолчанию включены).
# Отключите, если при создании ключа API не выбран соответствующий метод.
# CHECK_VERSIONS=1        # статусы версий и модерация
# CHECK_ACCESS=1          # выданные доступы
# CHECK_SUBSCRIPTIONS=1   # данные подписки в уведомлении о платеже

# Сводки (по умолчанию выключены)
# DIGEST_DAILY=1          # каждый день — за вчера
# DIGEST_WEEKLY=1         # раз в неделю — за прошедшие 7 дней
# DIGEST_WEEKLY_DAY=1     # 1 — понедельник … 7 — воскресенье
# DIGEST_TIME=09:00       # время отправки по TZ_OFFSET

# Предупреждать, если проверка падает N раз подряд (0 — выкл.)
# ALERT_AFTER_FAILURES=3
