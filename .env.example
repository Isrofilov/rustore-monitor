# Ключ доступа к RuStore API
RUSTORE_KEY_ID=2351027525
RUSTORE_PRIVATE_KEY=base64-закодированный-приватный-ключ

# Приложение
RUSTORE_PACKAGE_NAME=com.example.app
RUSTORE_APP_ID=123456

# Каналы уведомлений — настройте хотя бы один (Telegram и/или Matrix)

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=123        # id темы в супергруппе (опционально)
# TELEGRAM_DOMAIN=api.telegram.org  # домен Telegram API (опционально)

# Matrix
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=syt_xxx...
# MATRIX_ROOM_ID=!abcdef:matrix.org

# Интервал опроса в секундах (по умолчанию 300)
# POLL_INTERVAL=300

# Часовой пояс — смещение в часах (по умолчанию +3, МСК)
# TZ_OFFSET=3
